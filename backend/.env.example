NODE_ENV=development
APP_PORT=3001
APP_NAME="NestJS API"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3001
APP_CORS_ORIGINS=http://localhost:3000

DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=root
DATABASE_PASSWORD=secret
DATABASE_NAME=api
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=

# Support "local", "s3", "s3-presigned"
FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=Api
MAIL_CLIENT_PORT=1080

AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_FORGOT_SECRET=secret_for_forgot
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=secret_for_confirm_email
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
AUTH_UNIFORM_ERRORS=false

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_APP_AUDIENCE=[]

# Upstream LLM provider keys. Used by Parsim's own model calls (compression
# summaries, replay judge, demo agent, live tests). Customer traffic always uses
# the customer's own key. Leave empty if you don't use that provider.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Groq (console.groq.com, free tier, no card): free development runs of the
# demo agent and benchmark only. Never send real customer data through it.
GROQ_API_KEY=
# Groq model for development runs and the Groq live test (for example
# openai/gpt-oss-120b: 131k context, tool calling).
GROQ_MODEL=

# Provider and model for Parsim's own internal model calls.
# Provider: gemini, openai, anthropic or openai-compatible (Groq or any
# OpenAI-compatible API, with PARSIM_INTERNAL_BASE_URL). For Groq:
#   PARSIM_INTERNAL_PROVIDER=openai-compatible
#   PARSIM_INTERNAL_BASE_URL=https://api.groq.com/openai/v1
#   PARSIM_INTERNAL_API_KEY= (empty uses GROQ_API_KEY)
#   PARSIM_INTERNAL_MODEL=openai/gpt-oss-120b
#   PARSIM_INTERNAL_CONTEXT_TOKENS=131072
PARSIM_INTERNAL_PROVIDER=gemini
# Fill in the current Gemini Flash model name. Never hardcoded in code.
PARSIM_INTERNAL_MODEL=
# Key of the internal provider. Empty uses that provider's key above
# (GROQ_API_KEY for openai-compatible).
PARSIM_INTERNAL_API_KEY=
# The internal model's context window in tokens. A prompt estimated larger
# fails before it is sent. Required for free tiers with small limits.
PARSIM_INTERNAL_CONTEXT_TOKENS=

# Proxy (POST /v1/chat/completions)
# Require a Parsim key on every proxy request. Set to false only for local
# development: requests from localhost without a key then use the oldest
# project. Ignored when NODE_ENV=production.
PARSIM_REQUIRE_KEY=true
# openai-compatible project upstreams (for example Groq) use a custom base
# URL. To prevent server-side request forgery it must be https and on a host
# in this comma-separated allowlist (default api.groq.com)...
PARSIM_CUSTOM_UPSTREAM_HOSTS=
# ...unless this is true (development only, ignored when NODE_ENV=production):
# then any http or https URL is allowed.
PARSIM_ALLOW_CUSTOM_UPSTREAM=false
# Upstream base URLs. Defaults: https://api.openai.com,
# https://generativelanguage.googleapis.com/v1beta/openai and
# https://api.anthropic.com
PROXY_OPENAI_BASE_URL=
PROXY_GEMINI_BASE_URL=
# Gemini native API host (generateContent). Default: https://generativelanguage.googleapis.com
PROXY_GEMINI_NATIVE_BASE_URL=
PROXY_ANTHROPIC_BASE_URL=
# Max wait for upstream headers and between streamed chunks, in ms.
PROXY_UPSTREAM_TIMEOUT_MS=600000
# Max proxy request body size.
PROXY_BODY_LIMIT=32mb
# 32 random bytes, base64. Encrypts provider keys stored on projects.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PARSIM_ENCRYPTION_KEY=
# Editable model price table (USD per 1M tokens).
PARSIM_MODEL_PRICES_PATH=config/model-prices.json

# Context storage (agent sessions)
# Store the content of context items for projects that do not set
# storeContent themselves. Defaults to true outside production, false in
# production. Hashes, kinds and token counts are always stored.
PARSIM_STORE_CONTENT=
# Log prompt and tool content at debug level. Never enable in production.
DEBUG_CONTENT=false

# Context GC (shared by every project; each project sets its own gcMode:
# off, shadow or on, shadow by default). Empty values use the defaults.
# New decisions are made only above this many context tokens (8000).
GC_MIN_CONTEXT_TOKENS=
# A new GC pass runs only when the context added since the last pass is
# above this many tokens (4000), so the prompt prefix changes in batches.
GC_BATCH_TOKENS=
# The last N turns are never changed (6).
GC_PROTECTED_TURNS=
# Tool results above this many tokens (1500)...
GC_ARCHIVE_MIN_TOKENS=
# ...are archived once they are more than this many turns old (6).
GC_ARCHIVE_AFTER_TURNS=
# Comma-separated tool names with side effects, never dropped or archived,
# on top of the default patterns send_, create_, delete_, update_, pay and
# refund. Example: save_note,book_flight
GC_SIDE_EFFECT_TOOLS=
# Extra comma-separated name patterns with side effects ("post_", "charge").
GC_SIDE_EFFECT_PATTERNS=
# Most parsim_recall calls Parsim answers per request in GC "on" mode (3).
# 0 turns recall off (archive stubs are still sent).
PARSIM_RECALL_MAX_PER_REQUEST=

# Compression (GC "on" mode, for projects with compressionEnabled). Finished
# stretches of a session are summarized into a state block in the background.
# A stretch is summarized only above this many tokens (6000).
COMPRESSION_MIN_TOKENS=
# Run the summary worker in this process (true).
COMPRESSION_WORKER=
# How often the worker looks for jobs, in seconds (2).
COMPRESSION_POLL_SECONDS=
# Retries of a failed summary before it is marked failed (2).
COMPRESSION_RETRY_LIMIT=
# Overrides the base URL of PARSIM_INTERNAL_PROVIDER for summaries. Empty
# uses the proxy's base URL for that provider.
PARSIM_INTERNAL_BASE_URL=

# Replay (dashboard and npm run replay:fixtures). Recorded requests are sent
# again, as recorded and as the GC made them, and the answers compared.
# Needs content storage. Replay calls use the project's own provider key; the
# judge uses PARSIM_INTERNAL_* unless the project pays for it.
# Run the replay worker in this process (true).
REPLAY_WORKER=
# How often the worker looks for replays, in seconds (2).
REPLAY_POLL_SECONDS=
# Budget of a replay when none is given, in USD (1).
REPLAY_DEFAULT_BUDGET_USD=
# The largest budget a replay may be given, in USD (25).
REPLAY_MAX_BUDGET_USD=
# Request points replayed when none are chosen (5).
REPLAY_DEFAULT_POINTS=
# The most request points one replay may have (20).
REPLAY_MAX_POINTS=
# The judge's model on Parsim's key. Empty uses PARSIM_INTERNAL_MODEL.
REPLAY_JUDGE_MODEL=
# Judge scores (1 to 5) at or above this count as agreeing (4).
REPLAY_JUDGE_PASS_SCORE=
# Output tokens reserved, for the budget check, for a call whose request sets
# no output limit (4096).
REPLAY_OUTPUT_RESERVE_TOKENS=
# Output tokens assumed in the estimate when the recorded response has none (500).
REPLAY_DEFAULT_OUTPUT_TOKENS=

# NestJS Observe (APM, https://observe.nestjs.com). Runs only when both are
# set, and never when NODE_ENV=test. Leave empty to turn it off. Quote the
# secret in single quotes if it contains $ or other special characters.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
