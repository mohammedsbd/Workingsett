# Parsim demo agent. Copy to .env (never committed) and fill in what you use.
# Model names are never hardcoded: set them here.

# Default provider for npm run agent: gemini, groq, openai or anthropic.
DEMO_PROVIDER=gemini
# Temperature for every call (0 = repeatable). Empty: do not send one (some
# models only accept their default).
DEMO_TEMPERATURE=0
# Output tokens per call.
DEMO_MAX_OUTPUT_TOKENS=2048

# Gemini (default; published benchmark numbers use a paid key).
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_CONTEXT_TOKENS=

# Groq: free tier for development runs only (console.groq.com). Never send
# real customer data through a free-tier key.
GROQ_API_KEY=
# For example openai/gpt-oss-120b (131k context, tool calling).
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CONTEXT_TOKENS=131072
# The free tier rejects any request above its tokens-per-minute limit. Set it
# here (see console.groq.com/settings/limits) so the agent stops with a clear
# message instead. Empty: no per-request limit.
GROQ_MAX_REQUEST_TOKENS=
GROQ_FREE_TIER=true
# Groq free-tier daily quota (console.groq.com/settings/limits). The bench
# uses these to tell whether a run fits one day.
GROQ_DAILY_TOKENS=200000
GROQ_DAILY_REQUESTS=1000

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_CONTEXT_TOKENS=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_CONTEXT_TOKENS=

# Through Parsim (npm run agent -- --via parsim): the backend's URL and a
# Parsim key of a project whose upstream matches the provider (for Groq: an
# openai-compatible project with base URL https://api.groq.com/openai/v1).
PARSIM_BASE_URL=http://localhost:3001
PARSIM_API_KEY=

# Benchmark (npm run bench).
# Baselines: keep the last N turns; refresh the summary every M turns.
BENCH_TRUNCATE_TURNS=6
BENCH_SUMMARY_EVERY=6
# Internal model for the summarize baseline and the judge. Empty: the
# benchmarked provider and model.
BENCH_INTERNAL_PROVIDER=
BENCH_INTERNAL_MODEL=
# A Parsim user the bench signs in as, to create one project per Parsim arm.
BENCH_PARSIM_EMAIL=
BENCH_PARSIM_PASSWORD=
# Turn on Parsim's compression in the parsim-on arm (needs the backend's
# PARSIM_INTERNAL_* model).
BENCH_PARSIM_COMPRESSION=false
