{
  "name": "parsim-demo-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Long-running demo agents (research and support) for Parsim's benchmark, with recorded tools.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agent": "tsx src/cli/agent.ts",
    "record": "tsx src/cli/record.ts",
    "tasks:export": "tsx src/cli/export-tasks.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "bench": "tsx src/cli/bench.ts",
    "bench:report": "tsx src/cli/report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@google/genai": "2.28.0",
    "dotenv": "17.3.1",
    "openai": "7.28.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "prettier": "3.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
